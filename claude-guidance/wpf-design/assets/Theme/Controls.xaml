<!--
    Controls.xaml — styles and templates for the common WPF control set.

    Structure:
      1.  Text + surface primitives (implicit TextBlock, Card, Divider)
      2.  Buttons (Primary / Secondary / Ghost / Danger / Icon / Chip)
      3.  Text inputs
      4.  ComboBox
      5.  CheckBox + ToggleSwitch
      6.  Slider
      7.  ProgressBar
      8.  ScrollBar + ScrollViewer
      9.  ListBox / ListBoxItem
      10. TabControl / TabItem
      11. ToolTip + Separator

    Most styles are *implicit* (no x:Key) on purpose: an unstyled Button, TextBox or
    ScrollBar anywhere in the app picks up the right look without the view author
    remembering a style key. Keyed variants exist where genuine choice is needed.

    Every style sets FocusVisualStyle="{x:Null}" and draws its own focus ring. That is
    a replacement, not a removal — WPF's default dotted rectangle is the single most
    dated thing on screen, but keyboard users still need to see where they are.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ══════════════════════════════════════════════════════════════════════
         1.  TEXT + SURFACE PRIMITIVES
         ══════════════════════════════════════════════════════════════════════ -->

    <!-- Implicit TextBlock: every bare <TextBlock> gets body type and primary tone. -->
    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Body}"/>

    <!-- Card: the workhorse container. One elevation step up from its parent plus a
         1px subtle border. SnapsToDevicePixels keeps that hairline a hairline at
         125%/150% display scaling instead of a blurry 2px smear. -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Raised}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Md}"/>
        <Setter Property="Padding" Value="{StaticResource Pad.Card}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- Panel: a structural region (nav rail, side pane). No radius — it meets the
         window edge, and rounding a corner that touches the frame looks like a bug. -->
    <Style x:Key="Panel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Raised}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- Well: a recessed area content sits inside — text editors, log views, lists. -->
    <Style x:Key="Well" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Sunken}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Sm}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="Divider" TargetType="Border">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource Brush.Divider}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════════════
         2.  BUTTONS

         One base template; variants are Style triggers that repaint it. Style
         triggers outrank template triggers in WPF, so a variant can freely
         override hover/press colours without touching the template.
         ══════════════════════════════════════════════════════════════════════ -->

    <Style x:Key="Button.Base" TargetType="ButtonBase">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Height" Value="{StaticResource Height.Control}"/>
        <Setter Property="MinWidth" Value="80"/>
        <Setter Property="Padding" Value="{StaticResource Pad.Button}"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}"/>
        <Setter Property="FontSize" Value="{StaticResource Size.Body}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <!-- Arrow, not Hand: Hand means "hyperlink" on Windows. -->
        <Setter Property="Cursor" Value="Arrow"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Grid>
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Radius.Sm}"
                                SnapsToDevicePixels="True"/>
                        <!-- Focus ring drawn inside the bounds so it can never be
                             clipped by a parent with ClipToBounds. -->
                        <Border x:Name="FocusRing"
                                BorderBrush="{DynamicResource Brush.Border.Focus}"
                                BorderThickness="2"
                                CornerRadius="{StaticResource Radius.Sm}"
                                Opacity="0"
                                IsHitTestVisible="False"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          SnapsToDevicePixels="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Opacity" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Primary: exactly one per screen region. The accent is a scarce resource; if
         two buttons in view are both accent-filled, neither reads as the main action. -->
    <Style x:Key="Button.Primary" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent.Base}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Base}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Accent.Hover}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Hover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Accent.Pressed}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Pressed}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Secondary is the implicit Button style: most buttons are secondary. -->
    <Style x:Key="Button.Secondary" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Overlay}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Surface.Hover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Surface.Pressed}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}"/>

    <!-- Ghost: toolbar and in-row actions. No chrome until hovered, which keeps
         dense surfaces (list rows, toolbars) quiet. -->
    <Style x:Key="Button.Ghost" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Padding" Value="10,0,10,0"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Surface.Hover}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Surface.Pressed}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Danger is never the accent colour: destructive actions must not look like
         the recommended path. -->
    <Style x:Key="Button.Danger" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger.Base}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Danger.Text}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Danger.Base}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Danger.Hover}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Square icon button. Content is a glyph TextBlock using Font.Icon, e.g.
         <Button Style="{StaticResource Button.Icon}">
             <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE768;"/>
         </Button>
         Always give it a ToolTip and AutomationProperties.Name — an unlabelled
         glyph is invisible to screen readers and ambiguous to everyone else. -->
    <Style x:Key="Button.Icon" TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
        <Setter Property="Width" Value="{StaticResource Height.Control}"/>
        <Setter Property="Height" Value="{StaticResource Height.Control}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="MinWidth" Value="0"/>
    </Style>

    <!-- Chip / segmented toggle: engine pickers, view switchers, filter pills. -->
    <Style x:Key="Chip" TargetType="ToggleButton" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
        <Setter Property="Height" Value="{StaticResource Height.Control.Compact}"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Padding" Value="12,0,12,0"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Surface.Hover}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Accent.Muted}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Base}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Text}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════════════
         3.  TEXT INPUTS

         WPF has no placeholder concept. This template adds one by binding a
         TextBlock to Tag and showing it while Text is empty — set
         Tag="Search voices…" on any TextBox and it just works.
         ══════════════════════════════════════════════════════════════════════ -->

    <Style TargetType="TextBox">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Height" Value="{StaticResource Height.Control}"/>
        <Setter Property="Padding" Value="{StaticResource Pad.Control}"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}"/>
        <Setter Property="FontSize" Value="{StaticResource Size.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Sunken}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Accent.Text}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Brush.TextSelection}"/>
        <Setter Property="SelectionOpacity" Value="0.6"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Radius.Sm}"
                                SnapsToDevicePixels="True"/>
                        <TextBlock x:Name="Placeholder"
                                   Text="{TemplateBinding Tag}"
                                   Margin="{TemplateBinding Padding}"
                                   VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                   Foreground="{DynamicResource Brush.Text.Tertiary}"
                                   IsHitTestVisible="False"
                                   Visibility="Collapsed"/>
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Padding="{TemplateBinding Padding}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush"
                                    Value="{DynamicResource Brush.Border.Focus}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush"
                                    Value="{DynamicResource Brush.Accent.Base}"/>
                            <Setter TargetName="Bg" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Multi-line editor: the big text area in a generation or notes screen.
         Height Auto + Stretch alignment so the caret starts at the top, and
         AcceptsReturn/AcceptsTab set here rather than remembered per usage. -->
    <Style x:Key="TextBox.Multiline" TargetType="TextBox">
        <Setter Property="Height" Value="Auto"/>
        <Setter Property="MinHeight" Value="120"/>
        <Setter Property="AcceptsReturn" Value="True"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="14"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="LineHeight" Value="22"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}"/>
        <Setter Property="FontSize" Value="{StaticResource Size.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Sunken}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Accent.Text}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Brush.TextSelection}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Radius.Md}"
                                SnapsToDevicePixels="True"/>
                        <TextBlock x:Name="Placeholder"
                                   Text="{TemplateBinding Tag}"
                                   Margin="{TemplateBinding Padding}"
                                   VerticalAlignment="Top"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource Brush.Text.Tertiary}"
                                   IsHitTestVisible="False"
                                   Visibility="Collapsed"/>
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Padding="{TemplateBinding Padding}"
                                      Focusable="False"
                                      VerticalScrollBarVisibility="Auto"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush"
                                    Value="{DynamicResource Brush.Accent.Base}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════════════
         4.  COMBOBOX

         The default ComboBox is the second-most dated control in WPF after the
         ScrollBar: a bevelled toggle with a gradient. This is a full retemplate.
         Non-editable only — an editable ComboBox additionally needs a
         PART_EditableTextBox in the template.
         ══════════════════════════════════════════════════════════════════════ -->

    <Style x:Key="ComboBox.Toggle" TargetType="ToggleButton">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Padding" Value="10,7,10,7"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
        <Setter Property="FontSize" Value="{StaticResource Size.Body}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bg"
                            Background="Transparent"
                            CornerRadius="{StaticResource Radius.Xs}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bg" Property="Background"
                                    Value="{DynamicResource Brush.Surface.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bg" Property="Background"
                                    Value="{DynamicResource Brush.Surface.Selected}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Text}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Height" Value="{StaticResource Height.Control}"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}"/>
        <Setter Property="FontSize" Value="{StaticResource Size.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Overlay}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="MaxDropDownHeight" Value="320"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Radius.Sm}"
                                SnapsToDevicePixels="True"/>

                        <ToggleButton Style="{StaticResource ComboBox.Toggle}"
                                      ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                  RelativeSource={RelativeSource TemplatedParent}}"/>

                        <ContentPresenter x:Name="Site"
                                          Margin="12,0,32,0"
                                          VerticalAlignment="Center"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>

                        <!-- Chevron: Segoe Fluent Icons E70D (ChevronDown). -->
                        <TextBlock x:Name="Chevron"
                                   Text="&#xE70D;"
                                   FontFamily="{StaticResource Font.Icon}"
                                   FontSize="11"
                                   Margin="0,0,12,0"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Foreground="{DynamicResource Brush.Text.Tertiary}"/>

                        <Popup x:Name="PART_Popup"
                               Placement="Bottom"
                               VerticalOffset="4"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Fade"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               MinWidth="{TemplateBinding ActualWidth}">
                            <!-- Margin leaves room for the shadow to render; without it
                                 the popup clips its own blur. -->
                            <Border Margin="6,0,6,8"
                                    Background="{DynamicResource Brush.Surface.Overlay}"
                                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource Radius.Sm}"
                                    Padding="{StaticResource Pad.Popup}"
                                    Effect="{StaticResource Shadow.Popup}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer>
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background"
                                    Value="{DynamicResource Brush.Surface.Hover}"/>
                            <Setter TargetName="Chevron" Property="Foreground"
                                    Value="{DynamicResource Brush.Text.Primary}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush"
                                    Value="{DynamicResource Brush.Accent.Base}"/>
                            <Setter TargetName="Bg" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════════════
         5.  CHECKBOX + TOGGLE SWITCH
         ══════════════════════════════════════════════════════════════════════ -->

    <Style TargetType="CheckBox">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}"/>
        <Setter Property="FontSize" Value="{StaticResource Size.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="18" Height="18" VerticalAlignment="Center">
                            <Border x:Name="Box"
                                    Background="{DynamicResource Brush.Surface.Sunken}"
                                    BorderBrush="{DynamicResource Brush.Border.Strong}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource Radius.Xs}"
                                    SnapsToDevicePixels="True"/>
                            <!-- E73E = CheckMark -->
                            <TextBlock x:Name="Check"
                                       Text="&#xE73E;"
                                       FontFamily="{StaticResource Font.Icon}"
                                       FontSize="12"
                                       Foreground="{DynamicResource Brush.Text.OnAccent}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Opacity="0"/>
                        </Grid>
                        <ContentPresenter Margin="10,0,0,0"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background"
                                    Value="{DynamicResource Brush.Accent.Base}"/>
                            <Setter TargetName="Box" Property="BorderBrush"
                                    Value="{DynamicResource Brush.Accent.Base}"/>
                            <Setter TargetName="Check" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush"
                                    Value="{DynamicResource Brush.Border.Focus}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush"
                                    Value="{DynamicResource Brush.Border.Focus}"/>
                            <Setter TargetName="Box" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Toggle switch. Use it for settings that take effect immediately ("Auto-play
         after generation"); use a CheckBox when the change only applies on Save.
         That distinction is what makes settings screens feel predictable. -->
    <Style x:Key="ToggleSwitch" TargetType="ToggleButton">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Cursor" Value="Arrow"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border x:Name="Track"
                                Background="{DynamicResource Brush.Surface.Pressed}"
                                BorderBrush="{DynamicResource Brush.Border.Strong}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Pill}"/>
                        <Border x:Name="Knob"
                                Width="16" Height="16"
                                HorizontalAlignment="Left"
                                Margin="3,0,0,0"
                                CornerRadius="{StaticResource Radius.Pill}"
                                Background="{DynamicResource Brush.Text.Secondary}">
                            <Border.RenderTransform>
                                <TranslateTransform X="0"/>
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background"
                                    Value="{DynamicResource Brush.Accent.Base}"/>
                            <Setter TargetName="Track" Property="BorderBrush"
                                    Value="{DynamicResource Brush.Accent.Base}"/>
                            <Setter TargetName="Knob" Property="Background"
                                    Value="{DynamicResource Brush.Text.OnAccent}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Knob"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         To="18" Duration="0:0:0.15"
                                                         EasingFunction="{StaticResource Ease.Out}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Knob"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         To="0" Duration="0:0:0.15"
                                                         EasingFunction="{StaticResource Ease.Out}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush"
                                    Value="{DynamicResource Brush.Border.Focus}"/>
                            <Setter TargetName="Track" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════════════
         6.  SLIDER (horizontal)

         The filled portion left of the thumb is the DecreaseRepeatButton — that is
         how WPF gives you a "progress" track for free without a second binding.
         ══════════════════════════════════════════════════════════════════════ -->

    <Style x:Key="Slider.TrackFill" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Height="4" VerticalAlignment="Center"
                            CornerRadius="2"
                            Background="{DynamicResource Brush.Accent.Base}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Slider.TrackEmpty" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Height="4" VerticalAlignment="Center"
                            CornerRadius="2"
                            Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Slider.Thumb" TargetType="Thumb">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Width" Value="14"/>
        <Setter Property="Height" Value="14"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid>
                        <Border x:Name="Halo"
                                CornerRadius="{StaticResource Radius.Pill}"
                                Background="{DynamicResource Brush.Accent.Base}"
                                Opacity="0" Margin="-5"/>
                        <Border x:Name="Knob"
                                CornerRadius="{StaticResource Radius.Pill}"
                                Background="{DynamicResource Brush.Text.Primary}"
                                BorderBrush="{DynamicResource Brush.Accent.Base}"
                                BorderThickness="2"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Halo" Property="Opacity" Value="0.18"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Halo" Property="Opacity" Value="0.28"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Slider">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="MinWidth" Value="80"/>
        <Setter Property="IsMoveToPointEnabled" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent">
                        <Border Height="4" VerticalAlignment="Center"
                                CornerRadius="2"
                                Background="{DynamicResource Brush.Surface.Pressed}"/>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource Slider.TrackFill}"
                                              Command="Slider.DecreaseLarge"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource Slider.Thumb}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource Slider.TrackEmpty}"
                                              Command="Slider.IncreaseLarge"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════════════
         7.  PROGRESSBAR

         Indeterminate mode sweeps a gradient across the track rather than sliding a
         fixed-width block. That is deliberate: a gradient sweep needs no knowledge
         of the control's width, so it works in a 90px table cell and a 900px banner
         with the same markup.
         ══════════════════════════════════════════════════════════════════════ -->

    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="6"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Base}"/>
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Pressed}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid x:Name="Root" ClipToBounds="True">
                        <Border x:Name="PART_Track"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource Radius.Pill}"/>
                        <Border x:Name="PART_Indicator"
                                HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}"
                                CornerRadius="{StaticResource Radius.Pill}"/>
                        <Border x:Name="Sweep"
                                CornerRadius="{StaticResource Radius.Pill}"
                                Visibility="Collapsed">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#005B60E8" Offset="-0.4"/>
                                    <GradientStop Color="#FF6E73F2" Offset="-0.2"/>
                                    <GradientStop Color="#005B60E8" Offset="0.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="Sweep" Property="Visibility" Value="Visible"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard Name="SweepStory">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation
                                            Storyboard.TargetName="Sweep"
                                            Storyboard.TargetProperty="(Border.Background).(GradientBrush.GradientStops)[0].(GradientStop.Offset)"
                                            From="-0.4" To="1.0" Duration="0:0:1.4"/>
                                        <DoubleAnimation
                                            Storyboard.TargetName="Sweep"
                                            Storyboard.TargetProperty="(Border.Background).(GradientBrush.GradientStops)[1].(GradientStop.Offset)"
                                            From="-0.2" To="1.2" Duration="0:0:1.4"/>
                                        <DoubleAnimation
                                            Storyboard.TargetName="Sweep"
                                            Storyboard.TargetProperty="(Border.Background).(GradientBrush.GradientStops)[2].(GradientStop.Offset)"
                                            From="0.0" To="1.4" Duration="0:0:1.4"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="SweepStory"/>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════════════
         8.  SCROLLBAR + SCROLLVIEWER

         The highest-value retemplate in WPF. The default is 17px wide, opaque grey,
         and has arrow buttons nobody has clicked since 2006. This is a 10px overlay
         track whose thumb thickens on hover.
         ══════════════════════════════════════════════════════════════════════ -->

    <Style x:Key="ScrollBar.PageButton" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollBar.Thumb" TargetType="Thumb">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Fill"
                            Background="{DynamicResource Brush.Scroll.Thumb}"
                            CornerRadius="{StaticResource Radius.Pill}"
                            Margin="3"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fill" Property="Background"
                                    Value="{DynamicResource Brush.Scroll.ThumbHover}"/>
                            <Setter TargetName="Fill" Property="Margin" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Fill" Property="Background"
                                    Value="{DynamicResource Brush.Scroll.ThumbHover}"/>
                            <Setter TargetName="Fill" Property="Margin" Value="2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="ScrollBar.Vertical" TargetType="ScrollBar">
        <Grid Background="Transparent" Width="10">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollBar.PageButton}"
                                  Command="ScrollBar.PageUpCommand"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource ScrollBar.Thumb}"/>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollBar.PageButton}"
                                  Command="ScrollBar.PageDownCommand"/>
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="ScrollBar.Horizontal" TargetType="ScrollBar">
        <Grid Background="Transparent" Height="10">
            <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollBar.PageButton}"
                                  Command="ScrollBar.PageLeftCommand"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource ScrollBar.Thumb}"/>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollBar.PageButton}"
                                  Command="ScrollBar.PageRightCommand"/>
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>

    <Style TargetType="ScrollBar">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Width" Value="10"/>
        <Setter Property="MinWidth" Value="10"/>
        <Setter Property="Template" Value="{StaticResource ScrollBar.Vertical}"/>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="10"/>
                <Setter Property="MinHeight" Value="10"/>
                <Setter Property="Template" Value="{StaticResource ScrollBar.Horizontal}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ScrollViewer">
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="PanningMode" Value="VerticalOnly"/>
        <Setter Property="Focusable" Value="False"/>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════════════
         9.  LISTBOX / LISTBOXITEM

         The default WPF selection is a hard blue rectangle spanning the full row
         with no radius. Here selection is a soft accent-tinted fill with a 3px
         accent rail on the left — readable at a glance without shouting.
         ══════════════════════════════════════════════════════════════════════ -->

    <Style TargetType="ListBoxItem">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Padding" Value="12,8,12,8"/>
        <Setter Property="Margin" Value="0,0,0,2"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
        <Setter Property="FontSize" Value="{StaticResource Size.Body}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="Bg"
                                Background="Transparent"
                                CornerRadius="{StaticResource Radius.Sm}"
                                SnapsToDevicePixels="True"/>
                        <Border x:Name="Rail"
                                Width="3" HorizontalAlignment="Left"
                                Margin="0,6,0,6"
                                CornerRadius="{StaticResource Radius.Pill}"
                                Background="{DynamicResource Brush.Accent.Base}"
                                Opacity="0"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background"
                                    Value="{DynamicResource Brush.Surface.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bg" Property="Background"
                                    Value="{DynamicResource Brush.Surface.Selected}"/>
                            <Setter TargetName="Rail" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush"
                                    Value="{DynamicResource Brush.Border.Focus}"/>
                            <Setter TargetName="Bg" Property="BorderThickness" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Card items for a browser-style grid (voices, presets, models). Pair with a
         WrapPanel ItemsPanel. Note there is no DropShadowEffect here: a shadow per
         card is a per-element render pass and it will visibly stutter at 200 items. -->
    <Style x:Key="ListBoxItem.Card" TargetType="ListBoxItem">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Margin" Value="{StaticResource Gap.Card}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bg"
                            Background="{DynamicResource Brush.Surface.Raised}"
                            BorderBrush="{DynamicResource Brush.Border.Subtle}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Md}"
                            Padding="{StaticResource Pad.Card}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background"
                                    Value="{DynamicResource Brush.Surface.Overlay}"/>
                            <Setter TargetName="Bg" Property="BorderBrush"
                                    Value="{DynamicResource Brush.Border.Strong}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush"
                                    Value="{DynamicResource Brush.Accent.Base}"/>
                            <Setter TargetName="Bg" Property="Background"
                                    Value="{DynamicResource Brush.Surface.Selected}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Virtualization on, recycling mode, no chrome. A ListBox nested inside a
         ScrollViewer loses virtualization entirely (infinite measure height) — let
         the ListBox own its own scrolling. -->
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════════════
         10. TABCONTROL / TABITEM

         Underline tabs, not the default folder-tab chrome (which cannot be made to
         look current, only less bad).
         ══════════════════════════════════════════════════════════════════════ -->

    <Style TargetType="TabItem">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}"/>
        <Setter Property="FontSize" Value="{StaticResource Size.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
        <Setter Property="Padding" Value="2,0,2,0"/>
        <Setter Property="Margin" Value="0,0,20,0"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid Background="Transparent">
                        <ContentPresenter ContentSource="Header"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                        <Border x:Name="Underline"
                                Height="2" VerticalAlignment="Bottom"
                                CornerRadius="{StaticResource Radius.Pill}"
                                Background="{DynamicResource Brush.Accent.Base}"
                                Opacity="0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter TargetName="Underline" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Underline" Property="Opacity" Value="0.5"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Height="38">
                            <Border Height="1" VerticalAlignment="Bottom"
                                    Background="{DynamicResource Brush.Divider}"/>
                            <TabPanel IsItemsHost="True" Panel.ZIndex="1"/>
                        </Grid>
                        <ContentPresenter Grid.Row="1"
                                          Margin="0,16,0,0"
                                          ContentSource="SelectedContent"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════════════
         11. TOOLTIP + SEPARATOR

         Tooltips carry the explanation for advanced parameters (CFG strength, NFE
         steps, temperature) so the control itself can stay a clean label + input.
         Wrap and cap the width — a 900px single-line tooltip is unreadable.
         ══════════════════════════════════════════════════════════════════════ -->

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Overlay}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}"/>
        <Setter Property="FontSize" Value="{StaticResource Size.Caption}"/>
        <Setter Property="Padding" Value="10,7,10,7"/>
        <Setter Property="MaxWidth" Value="320"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Placement" Value="Bottom"/>
        <Setter Property="VerticalOffset" Value="4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource Brush.Border.Subtle}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Sm}"
                            Padding="{TemplateBinding Padding}"
                            Effect="{StaticResource Shadow.Popup}">
                        <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"
                                          TextBlock.TextWrapping="Wrap"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="0,8,0,8"/>
        <Setter Property="Background" Value="{DynamicResource Brush.Divider}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Background="{TemplateBinding Background}"
                            SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
