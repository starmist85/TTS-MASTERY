<!--
    Palette.Light.xaml — light counterpart to Palette.Dark.xaml.

    Identical key set, different values. That is the whole contract: because every
    style binds these by DynamicResource and no view hardcodes a color, swapping
    this dictionary in re-themes the running app with no other code.

    Note the inversion of the elevation logic: on dark, higher surfaces get lighter;
    on light, the *base* is the lightest and depth is expressed by slightly darker
    recessed surfaces plus stronger borders. Copying the dark ordering literally is
    the classic mistake that makes a light theme look washed out.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  SURFACES  -->
    <Color x:Key="Color.Surface.Sunken">#FFEFF1F5</Color>
    <Color x:Key="Color.Surface.Base">#FFF7F8FA</Color>
    <Color x:Key="Color.Surface.Raised">#FFFFFFFF</Color>
    <Color x:Key="Color.Surface.Overlay">#FFFFFFFF</Color>
    <Color x:Key="Color.Surface.Hover">#FFEDEFF4</Color>
    <Color x:Key="Color.Surface.Pressed">#FFE2E6EE</Color>
    <Color x:Key="Color.Surface.Selected">#FFE8EAFB</Color>

    <SolidColorBrush x:Key="Brush.Surface.Sunken" Color="{StaticResource Color.Surface.Sunken}"/>
    <SolidColorBrush x:Key="Brush.Surface.Base" Color="{StaticResource Color.Surface.Base}"/>
    <SolidColorBrush x:Key="Brush.Surface.Raised" Color="{StaticResource Color.Surface.Raised}"/>
    <SolidColorBrush x:Key="Brush.Surface.Overlay" Color="{StaticResource Color.Surface.Overlay}"/>
    <SolidColorBrush x:Key="Brush.Surface.Hover" Color="{StaticResource Color.Surface.Hover}"/>
    <SolidColorBrush x:Key="Brush.Surface.Pressed" Color="{StaticResource Color.Surface.Pressed}"/>
    <SolidColorBrush x:Key="Brush.Surface.Selected" Color="{StaticResource Color.Surface.Selected}"/>

    <!--  BORDERS  -->
    <Color x:Key="Color.Border.Subtle">#FFE3E6EC</Color>
    <Color x:Key="Color.Border.Strong">#FFC7CDD8</Color>
    <Color x:Key="Color.Border.Focus">#FF4F46E5</Color>

    <SolidColorBrush x:Key="Brush.Border.Subtle" Color="{StaticResource Color.Border.Subtle}"/>
    <SolidColorBrush x:Key="Brush.Border.Strong" Color="{StaticResource Color.Border.Strong}"/>
    <SolidColorBrush x:Key="Brush.Border.Focus" Color="{StaticResource Color.Border.Focus}"/>

    <!--  TEXT  -->
    <Color x:Key="Color.Text.Primary">#FF14161B</Color>
    <Color x:Key="Color.Text.Secondary">#FF565E70</Color>
    <Color x:Key="Color.Text.Tertiary">#FF6E7687</Color>
    <Color x:Key="Color.Text.Disabled">#FFA9B0BE</Color>
    <Color x:Key="Color.Text.OnAccent">#FFFFFFFF</Color>

    <SolidColorBrush x:Key="Brush.Text.Primary" Color="{StaticResource Color.Text.Primary}"/>
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{StaticResource Color.Text.Secondary}"/>
    <SolidColorBrush x:Key="Brush.Text.Tertiary" Color="{StaticResource Color.Text.Tertiary}"/>
    <SolidColorBrush x:Key="Brush.Text.Disabled" Color="{StaticResource Color.Text.Disabled}"/>
    <SolidColorBrush x:Key="Brush.Text.OnAccent" Color="{StaticResource Color.Text.OnAccent}"/>

    <!--  ACCENT  — darker than the dark theme's accent so white text clears AA (6.3:1). -->
    <Color x:Key="Color.Accent.Base">#FF4F46E5</Color>
    <Color x:Key="Color.Accent.Hover">#FF443BD8</Color>
    <Color x:Key="Color.Accent.Pressed">#FF3A31C4</Color>
    <Color x:Key="Color.Accent.Text">#FF4338CA</Color>
    <Color x:Key="Color.Accent.Muted">#1A4F46E5</Color>

    <SolidColorBrush x:Key="Brush.Accent.Base" Color="{StaticResource Color.Accent.Base}"/>
    <SolidColorBrush x:Key="Brush.Accent.Hover" Color="{StaticResource Color.Accent.Hover}"/>
    <SolidColorBrush x:Key="Brush.Accent.Pressed" Color="{StaticResource Color.Accent.Pressed}"/>
    <SolidColorBrush x:Key="Brush.Accent.Text" Color="{StaticResource Color.Accent.Text}"/>
    <SolidColorBrush x:Key="Brush.Accent.Muted" Color="{StaticResource Color.Accent.Muted}"/>

    <!--  STATE  -->
    <Color x:Key="Color.Success.Base">#FF1A7F37</Color>
    <Color x:Key="Color.Success.Text">#FF116329</Color>
    <Color x:Key="Color.Warning.Base">#FF9A6700</Color>
    <Color x:Key="Color.Warning.Text">#FF7D4E00</Color>
    <Color x:Key="Color.Danger.Base">#FFCF222E</Color>
    <Color x:Key="Color.Danger.Hover">#FFB81B26</Color>
    <Color x:Key="Color.Danger.Text">#FFA40E26</Color>
    <Color x:Key="Color.Neutral.Base">#FF8C94A3</Color>

    <SolidColorBrush x:Key="Brush.Success.Base" Color="{StaticResource Color.Success.Base}"/>
    <SolidColorBrush x:Key="Brush.Success.Text" Color="{StaticResource Color.Success.Text}"/>
    <SolidColorBrush x:Key="Brush.Warning.Base" Color="{StaticResource Color.Warning.Base}"/>
    <SolidColorBrush x:Key="Brush.Warning.Text" Color="{StaticResource Color.Warning.Text}"/>
    <SolidColorBrush x:Key="Brush.Danger.Base" Color="{StaticResource Color.Danger.Base}"/>
    <SolidColorBrush x:Key="Brush.Danger.Hover" Color="{StaticResource Color.Danger.Hover}"/>
    <SolidColorBrush x:Key="Brush.Danger.Text" Color="{StaticResource Color.Danger.Text}"/>
    <SolidColorBrush x:Key="Brush.Neutral.Base" Color="{StaticResource Color.Neutral.Base}"/>

    <!--  CHROME  -->
    <SolidColorBrush x:Key="Brush.Scroll.Thumb" Color="#FFC2C8D2"/>
    <SolidColorBrush x:Key="Brush.Scroll.ThumbHover" Color="#FFA6AEBB"/>
    <SolidColorBrush x:Key="Brush.Divider" Color="#FFE7EAF0"/>
    <SolidColorBrush x:Key="Brush.TextSelection" Color="#FFB9BCF5"/>
    <SolidColorBrush x:Key="Brush.Shadow" Color="#FF404862"/>

    <!--  DATA / MEDIA  -->
    <SolidColorBrush x:Key="Brush.Waveform" Color="#FF6366F1"/>
    <SolidColorBrush x:Key="Brush.Waveform.Played" Color="#FF3730A3"/>
    <SolidColorBrush x:Key="Brush.Meter.Nominal" Color="#FF1A7F37"/>
    <SolidColorBrush x:Key="Brush.Meter.Warn" Color="#FF9A6700"/>
    <SolidColorBrush x:Key="Brush.Meter.Clip" Color="#FFCF222E"/>

</ResourceDictionary>
