<!--
    Palette.Dark.xaml — dark "pro-audio studio" palette.

    Colors only. Everything else (type, spacing, radii, motion) lives in Tokens.xaml,
    and every control style references these by DynamicResource so the whole app
    re-themes when this dictionary is swapped for Palette.Light.xaml at runtime.

    Naming: Brush.<Role>.<Variant>. Roles are semantic, never literal — there is no
    "Brush.Gray3" here on purpose, because a name like that gives you no guidance
    about where to use it and no way to swap themes coherently.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  SURFACES  ────────────────────────────────────────────────────────────
          Four levels. Elevation on dark is expressed by getting *lighter*, not by
          shadows. Sunken is for wells that content sits inside (text editors, list
          backgrounds); Base is the app background; Raised is panels; Overlay is
          cards, popups, menus and dialogs.                                      -->
    <Color x:Key="Color.Surface.Sunken">#FF0A0C10</Color>
    <Color x:Key="Color.Surface.Base">#FF0F1115</Color>
    <Color x:Key="Color.Surface.Raised">#FF161920</Color>
    <Color x:Key="Color.Surface.Overlay">#FF1D212A</Color>
    <Color x:Key="Color.Surface.Hover">#FF232833</Color>
    <Color x:Key="Color.Surface.Pressed">#FF2B313E</Color>
    <Color x:Key="Color.Surface.Selected">#FF262C3B</Color>

    <SolidColorBrush x:Key="Brush.Surface.Sunken" Color="{StaticResource Color.Surface.Sunken}"/>
    <SolidColorBrush x:Key="Brush.Surface.Base" Color="{StaticResource Color.Surface.Base}"/>
    <SolidColorBrush x:Key="Brush.Surface.Raised" Color="{StaticResource Color.Surface.Raised}"/>
    <SolidColorBrush x:Key="Brush.Surface.Overlay" Color="{StaticResource Color.Surface.Overlay}"/>
    <SolidColorBrush x:Key="Brush.Surface.Hover" Color="{StaticResource Color.Surface.Hover}"/>
    <SolidColorBrush x:Key="Brush.Surface.Pressed" Color="{StaticResource Color.Surface.Pressed}"/>
    <SolidColorBrush x:Key="Brush.Surface.Selected" Color="{StaticResource Color.Surface.Selected}"/>

    <!--  BORDERS  ─────────────────────────────────────────────────────────────
          Subtle separates surfaces of the same family; Strong is for input fields
          and anything the user is meant to perceive as an editable boundary.     -->
    <Color x:Key="Color.Border.Subtle">#FF262B35</Color>
    <Color x:Key="Color.Border.Strong">#FF373E4C</Color>
    <Color x:Key="Color.Border.Focus">#FF8B90FF</Color>

    <SolidColorBrush x:Key="Brush.Border.Subtle" Color="{StaticResource Color.Border.Subtle}"/>
    <SolidColorBrush x:Key="Brush.Border.Strong" Color="{StaticResource Color.Border.Strong}"/>
    <SolidColorBrush x:Key="Brush.Border.Focus" Color="{StaticResource Color.Border.Focus}"/>

    <!--  TEXT  ────────────────────────────────────────────────────────────────
          Four tones, deliberately. Primary 13.9:1, Secondary 6.6:1, Tertiary 4.6:1
          against Surface.Base — all pass WCAG AA for their intended use. Disabled
          is intentionally below AA: it must read as unavailable.                  -->
    <Color x:Key="Color.Text.Primary">#FFE9ECF2</Color>
    <Color x:Key="Color.Text.Secondary">#FF9BA3B4</Color>
    <Color x:Key="Color.Text.Tertiary">#FF7A8395</Color>
    <Color x:Key="Color.Text.Disabled">#FF4E5565</Color>
    <Color x:Key="Color.Text.OnAccent">#FFFFFFFF</Color>

    <SolidColorBrush x:Key="Brush.Text.Primary" Color="{StaticResource Color.Text.Primary}"/>
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{StaticResource Color.Text.Secondary}"/>
    <SolidColorBrush x:Key="Brush.Text.Tertiary" Color="{StaticResource Color.Text.Tertiary}"/>
    <SolidColorBrush x:Key="Brush.Text.Disabled" Color="{StaticResource Color.Text.Disabled}"/>
    <SolidColorBrush x:Key="Brush.Text.OnAccent" Color="{StaticResource Color.Text.OnAccent}"/>

    <!--  ACCENT  ──────────────────────────────────────────────────────────────
          One accent, four uses: primary action, current selection, focus ring,
          active navigation. Accent.Base against white text is 4.9:1 (AA).
          Accent.Text is the lighter tone for accent-colored *text* on dark, where
          the base would be too dark to read.                                     -->
    <Color x:Key="Color.Accent.Base">#FF5B60E8</Color>
    <Color x:Key="Color.Accent.Hover">#FF6E73F2</Color>
    <Color x:Key="Color.Accent.Pressed">#FF4A4FD2</Color>
    <Color x:Key="Color.Accent.Text">#FFA5A9FF</Color>
    <Color x:Key="Color.Accent.Muted">#332F34C8</Color>

    <SolidColorBrush x:Key="Brush.Accent.Base" Color="{StaticResource Color.Accent.Base}"/>
    <SolidColorBrush x:Key="Brush.Accent.Hover" Color="{StaticResource Color.Accent.Hover}"/>
    <SolidColorBrush x:Key="Brush.Accent.Pressed" Color="{StaticResource Color.Accent.Pressed}"/>
    <SolidColorBrush x:Key="Brush.Accent.Text" Color="{StaticResource Color.Accent.Text}"/>
    <SolidColorBrush x:Key="Brush.Accent.Muted" Color="{StaticResource Color.Accent.Muted}"/>

    <!--  STATE  ───────────────────────────────────────────────────────────────
          .Base is a fill (badges, bars); .Text is the readable tone on dark.
          Always pair these with a text label — never signal by color alone.       -->
    <Color x:Key="Color.Success.Base">#FF2EA043</Color>
    <Color x:Key="Color.Success.Text">#FF56D364</Color>
    <Color x:Key="Color.Warning.Base">#FFBB8009</Color>
    <Color x:Key="Color.Warning.Text">#FFE3B341</Color>
    <Color x:Key="Color.Danger.Base">#FFC93C37</Color>
    <Color x:Key="Color.Danger.Hover">#FFDA4A44</Color>
    <Color x:Key="Color.Danger.Text">#FFFF7B72</Color>
    <Color x:Key="Color.Neutral.Base">#FF515A6B</Color>

    <SolidColorBrush x:Key="Brush.Success.Base" Color="{StaticResource Color.Success.Base}"/>
    <SolidColorBrush x:Key="Brush.Success.Text" Color="{StaticResource Color.Success.Text}"/>
    <SolidColorBrush x:Key="Brush.Warning.Base" Color="{StaticResource Color.Warning.Base}"/>
    <SolidColorBrush x:Key="Brush.Warning.Text" Color="{StaticResource Color.Warning.Text}"/>
    <SolidColorBrush x:Key="Brush.Danger.Base" Color="{StaticResource Color.Danger.Base}"/>
    <SolidColorBrush x:Key="Brush.Danger.Hover" Color="{StaticResource Color.Danger.Hover}"/>
    <SolidColorBrush x:Key="Brush.Danger.Text" Color="{StaticResource Color.Danger.Text}"/>
    <SolidColorBrush x:Key="Brush.Neutral.Base" Color="{StaticResource Color.Neutral.Base}"/>

    <!--  CHROME  ──────────────────────────────────────────────────────────────
          Scrollbar thumbs, dividers, selection highlight in text boxes.           -->
    <SolidColorBrush x:Key="Brush.Scroll.Thumb" Color="#FF3A4150"/>
    <SolidColorBrush x:Key="Brush.Scroll.ThumbHover" Color="#FF4C5464"/>
    <SolidColorBrush x:Key="Brush.Divider" Color="#FF222731"/>
    <SolidColorBrush x:Key="Brush.TextSelection" Color="#FF3A3FA8"/>
    <SolidColorBrush x:Key="Brush.Shadow" Color="#FF000000"/>

    <!--  DATA / MEDIA  ─────────────────────────────────────────────────────────
          Waveforms, meters, charts. Level colors are semantic: green nominal,
          amber approaching, red clipping.                                          -->
    <SolidColorBrush x:Key="Brush.Waveform" Color="#FF6E73F2"/>
    <SolidColorBrush x:Key="Brush.Waveform.Played" Color="#FFA5A9FF"/>
    <SolidColorBrush x:Key="Brush.Meter.Nominal" Color="#FF56D364"/>
    <SolidColorBrush x:Key="Brush.Meter.Warn" Color="#FFE3B341"/>
    <SolidColorBrush x:Key="Brush.Meter.Clip" Color="#FFFF7B72"/>

</ResourceDictionary>
